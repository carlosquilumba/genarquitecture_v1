# --- Configuración de Azure OpenAI ---
# Tipo de API de Azure OpenAI (normalmente "azure").
AZURE_OPENAI_API_TYPE=""
# URL base de tu instancia de Azure OpenAI.
AZURE_OPENAI_API_BASE=""
# Clave de API para autenticación con Azure OpenAI.
AZURE_OPENAI_API_KEY=""
# Nombre del despliegue del modelo de Azure OpenAI (ej: "gpt-4o-mini").
AZURE_OPENAI_DEPLOYMENT_NAME=""
# --- Configuración de Minio (almacenamiento de objetos) ---
# Endpoint de Minio. Si Minio se ejecuta con docker-compose, usa el nombre del servicio (ej: "http://minio:9000").
MINIO_ENDPOINT="http://minio:9000"

# --- Credenciales de usuario root para Minio (para acceso inicial) ---
# Usuario root por defecto para Minio.
MINIO_ROOT_USER="minioadmin"
# Contraseña root por defecto para Minio.
MINIO_ROOT_PASSWORD="minioadmin"